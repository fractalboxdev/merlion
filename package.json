{
  "name": "merlion-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "test": "pnpm -r --if-present test && node scripts/check-docs-alignment.mjs",
    "docs": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "docs:deploy": "pnpm --filter docs run deploy",
    "size": "pnpm --filter @fractalbox/merlion-view size",
    "determinism": "pnpm --dir bench bench determinism"
  }
}
