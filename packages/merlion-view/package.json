{
  "name": "@fractalboxdev/merlion-view",
  "version": "0.1.0",
  "description": "<merlion-view>: pan, zoom and fullscreen for any inline SVG diagram, plus click-to-highlight for Merlion flowcharts and sequence diagrams. No dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fractalboxdev/merlion.git",
    "directory": "packages/merlion-view"
  },
  "type": "module",
  "sideEffects": [
    "./merlion-view.js",
    "./interact.js"
  ],
  "exports": {
    ".": {
      "types": "./merlion-view.d.ts",
      "default": "./merlion-view.js"
    },
    "./zoom": {
      "types": "./zoom.d.ts",
      "default": "./zoom.js"
    },
    "./interact": {
      "types": "./interact.d.ts",
      "default": "./interact.js"
    }
  },
  "types": "./merlion-view.d.ts",
  "files": [
    "merlion-view.js",
    "merlion-view.d.ts",
    "zoom.js",
    "zoom.d.ts",
    "interact.js",
    "interact.d.ts",
    "interact-model.js",
    "interact-seq.js"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "size": "node scripts/size.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
