// Cloudflare Worker serving the built site from static assets (no Worker script).
// Workers Builds: root directory `docs`, build `sh ../scripts/cf-build.sh`, deploy
// `pnpm exec wrangler deploy`, preview `pnpm exec wrangler versions upload`.
// See README.md#docs-site for tool versions and build variables.
// Deploy: `pnpm --filter docs run deploy` (astro build + wrangler deploy). The account comes
// from CLOUDFLARE_ACCOUNT_ID or `wrangler login`; none is committed here.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "merlion-docs",
  "compatibility_date": "2026-09-01",
  // The site answers on its custom domain only; branch builds still get a preview URL.
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // The site answers on its own hostname; wrangler creates the DNS record and the custom
  // domain on deploy. The custom domain requires its zone in the deploying account.
  "routes": [{ "pattern": "merlion.fractalbox.dev", "custom_domain": true }]
}
