// Cloudflare Worker serving the built site from static assets (no Worker script).
// Deploy: `pnpm --filter docs run deploy` (astro build + wrangler deploy). The account comes
// from CLOUDFLARE_ACCOUNT_ID or `wrangler login`; none is committed here.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "merlion-docs",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
