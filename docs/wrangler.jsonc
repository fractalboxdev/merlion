// Cloudflare Worker serving the built site from static assets (no Worker script).
// Workers Builds: root directory `docs`, build `sh ../scripts/cf-build.sh`, deploy
// `pnpm exec wrangler deploy`, preview `pnpm exec wrangler versions upload`.
// See README.md#docs-site for tool versions and build variables.
// Deploy: `pnpm --filter docs run deploy` (astro build + wrangler deploy). The account comes
// from CLOUDFLARE_ACCOUNT_ID or `wrangler login`; none is committed here.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "merlion-docs",
  "compatibility_date": "2026-09-01",
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
