    {
      "name": "request-lifecycle",
      "size": "medium",
      "prompt": "The lifecycle of an HTTP request through a server. \"Client\" goes to \"Load balancer\", which goes to \"Rate limiter\". A request over the limit goes to \"Reject 429\". A request under the limit goes to \"Authenticate\". An unauthenticated request goes to \"Reject 401\". An authenticated request goes to \"Route\", which goes to \"Handler\". \"Handler\" goes to \"Database\" and to \"Cache\". Both go to \"Serialise response\", which goes to \"Client\".",
      "reference": {
        "nodes": [
          { "id": "client", "label": "Client" },
          { "id": "lb", "label": "Load balancer" },
          { "id": "rate", "label": "Rate limiter" },
          { "id": "r429", "label": "Reject 429" },
          { "id": "auth", "label": "Authenticate" },
          { "id": "r401", "label": "Reject 401" },
          { "id": "route", "label": "Route" },
          { "id": "handler", "label": "Handler" },
          { "id": "db", "label": "Database" },
          { "id": "cache", "label": "Cache" },
          { "id": "ser", "label": "Serialise response" }
        ],
        "edges": [
          { "from": "client", "to": "lb", "label": "" },
          { "from": "lb", "to": "rate", "label": "" },
          { "from": "rate", "to": "r429", "label": "over limit" },
          { "from": "rate", "to": "auth", "label": "under limit" },
          { "from": "auth", "to": "r401", "label": "anonymous" },
          { "from": "auth", "to": "route", "label": "authenticated" },
          { "from": "route", "to": "handler", "label": "" },
          { "from": "handler", "to": "db", "label": "" },
          { "from": "handler", "to": "cache", "label": "" },
          { "from": "db", "to": "ser", "label": "" },
          { "from": "cache", "to": "ser", "label": "" },
          { "from": "ser", "to": "client", "label": "" }
        ]
      }
    },
