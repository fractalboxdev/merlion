    {
      "name": "long-labels",
      "size": "small",
      "prompt": "A document review flow whose steps have long names. \"Submit the manuscript for editorial review\" goes to \"Assign two independent reviewers\". That goes to \"Collect reviewer recommendations\". If the recommendations agree, it goes to \"Notify the author of the decision\"; if they conflict, it goes to \"Assign a third reviewer as tie-breaker\", which goes to \"Notify the author of the decision\".",
      "reference": {
        "nodes": [
          { "id": "submit", "label": "Submit the manuscript for editorial review" },
          { "id": "assign", "label": "Assign two independent reviewers" },
