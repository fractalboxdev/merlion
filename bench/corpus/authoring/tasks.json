{
  "corpus": "authoring",
  "version": 1,
  "licence": "MIT (original, written for this benchmark)",
  "note": "Each task states a graph in prose and declares the same graph as data. The prose is what a model is given; the declared graph is the ground truth every output is scored against. Node labels are quoted in the prose exactly as the reference spells them, so a model that follows the prose scores full node fidelity in either output format. Edge labels are scored apart from topology, because the prose names a condition without fixing its wording.",
  "tasks": [
    {
      "name": "ci-pipeline",
      "size": "small",
      "prompt": "A continuous integration pipeline. A \"Push\" starts a \"Build\". If the build succeeds it runs \"Test\"; if it fails it goes to \"Notify author\". If the test passes it runs \"Deploy\"; if it fails it also goes to \"Notify author\". \"Deploy\" ends at \"Done\".",
      "reference": {
        "nodes": [
          { "id": "push", "label": "Push" },
          { "id": "build", "label": "Build" },
          { "id": "test", "label": "Test" },
          { "id": "notify", "label": "Notify author" },
          { "id": "deploy", "label": "Deploy" },
          { "id": "done", "label": "Done" }
        ],
        "edges": [
          { "from": "push", "to": "build", "label": "" },
          { "from": "build", "to": "test", "label": "succeeds" },
          { "from": "build", "to": "notify", "label": "fails" },
          { "from": "test", "to": "deploy", "label": "passes" },
          { "from": "test", "to": "notify", "label": "fails" },
          { "from": "deploy", "to": "done", "label": "" }
        ]
      }
    },
    {
      "name": "password-reset",
      "size": "small",
      "prompt": "A password reset flow. \"Request reset\" leads to \"Send email\". \"Send email\" leads to \"Open link\". \"Open link\" leads to \"Check token\". If the token is valid, \"Check token\" leads to \"Set password\"; if it has expired it leads back to \"Request reset\". \"Set password\" leads to \"Sign in\".",
      "reference": {
        "nodes": [
          { "id": "request", "label": "Request reset" },
          { "id": "email", "label": "Send email" },
          { "id": "open", "label": "Open link" },
          { "id": "check", "label": "Check token" },
          { "id": "set", "label": "Set password" },
          { "id": "signin", "label": "Sign in" }
        ],
        "edges": [
          { "from": "request", "to": "email", "label": "" },
          { "from": "email", "to": "open", "label": "" },
          { "from": "open", "to": "check", "label": "" },
          { "from": "check", "to": "set", "label": "valid" },
          { "from": "check", "to": "request", "label": "expired" },
          { "from": "set", "to": "signin", "label": "" }
        ]
      }
    },
    {
